# Copy to .env.prod and fill in values. NEVER commit .env.prod.
# Generate SECRET_KEY with: openssl rand -hex 32

SECRET_KEY=

POSTGRES_DB=wms_db
POSTGRES_USER=wms
POSTGRES_PASSWORD=

# Browser origins allowed by CORS (JSON array). The nginx proxy serves the SPA
# on the same origin, so this list is only needed for direct API access from
# other domains. Example:
# CORS_ORIGINS=["https://wms.example.com"]

# Host port for the frontend (nginx). Default 80.
# HTTP_PORT=80

# Warehouse demo simulation. Keep false in production.
# SIMULATION_ENABLED=false
